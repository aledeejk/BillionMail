# Environment Configuration Template
# Copy this file to .env and adjust values as needed

# ============================================
# Database Configuration
# ============================================
DBNAME=billionmail
DBUSER=billionmail
DBPASS=NauF7ysRYyt9HTOiOn4JjIAL3QcRZnzj
DB_HOST=127.0.0.1
DB_PORT=5432

# ============================================
# Administrator Credentials
# ============================================
ADMIN_USERNAME=billion
ADMIN_PASSWORD=billion

# ============================================
# Security Configuration
# ============================================
# Safe path for restricted admin access
SafePath=billion

# ============================================
# Redis Configuration
# ============================================
REDISPASS=zKLnZQr3riFpcS2lEy3MOtfncztaCGKp
REDIS_PORT=127.0.0.1:26379

# ============================================
# Mail Server Configuration
# ============================================
BILLIONMAIL_HOSTNAME=mail.example.com

# Mail Server Ports
SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP_PORT=110
POPS_PORT=995

# ============================================
# Web Server Ports
# ============================================
HTTP_PORT=80
HTTPS_PORT=443

# ============================================
# System Configuration
# ============================================
TZ=Etc/UTC

# Enable fail2ban access restrictions
FAIL2BAN_INIT=y

# Console IP whitelist (Disabled:false, Enabled:true)
IP_WHITELIST_ENABLE=false

# Number of days to keep log backup
RETENTION_DAYS=7

# ============================================
# Docker Configuration
# ============================================
# Default containers IPv4 intranet segment
IPV4_NETWORK=172.66.1
